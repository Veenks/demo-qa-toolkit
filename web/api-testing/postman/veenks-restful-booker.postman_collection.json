{
  "info": {
    "name": "Veenks \u2014 Restful-booker API Tests",
    "description": "API test suite for https://restful-booker.herokuapp.com \u2014 covers auth, CRUD on bookings, negative cases, and several documented quirks in the API's real behavior.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get auth token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('response has a token', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.token).to.be.a('string');",
                  "    pm.environment.set('token', json.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Auth with invalid credentials (known quirk: returns 200, not 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"wrong_user\",\n  \"password\": \"wrong_password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Known API quirk: invalid credentials still return HTTP 200,",
                  "// with a 'reason' field instead of a 401/403 and no token.",
                  "// Documented here on purpose, not treated as a script bug.",
                  "pm.test('status code is 200 (quirk, not a real success)', () => pm.response.to.have.status(200));",
                  "pm.test('response has no token, only a reason', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.token).to.be.undefined;",
                  "    pm.expect(json.reason).to.exist;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Booking - Read",
      "item": [
        {
          "name": "List all bookings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/booking",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "booking"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('response is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List bookings filtered by name",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/booking?firstname=Sally&lastname=Brown",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "booking"
              ],
              "query": [
                {
                  "key": "firstname",
                  "value": "Sally"
                },
                {
                  "key": "lastname",
                  "value": "Brown"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('response is an array', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "// Note: name filtering works reliably. Filtering by checkout date is a",
                  "// known separate issue (returns inconsistent results) \u2014 not covered here",
                  "// to avoid a flaky assertion; see README for details."
                ]
              }
            }
          ]
        },
        {
          "name": "Get booking by id \u2014 not found",
          "request": {
            "method": "GET",
            "header": [],
