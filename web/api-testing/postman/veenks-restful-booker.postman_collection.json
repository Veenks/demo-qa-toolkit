              "raw": "{{base_url}}/booking/999999999",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "booking",
                "999999999"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
